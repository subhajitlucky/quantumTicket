# Sepolia RPC URL (Alchemy, Infura, Tenderly, or any public endpoint)
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co

# Etherscan API key (only needed for contract verification)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Deployer key: use a dedicated wallet, never your main wallet.
# It becomes the contract owner, so transfer ownership if you use a burner.
PRIVATE_KEY=your-64-character-private-key-here
